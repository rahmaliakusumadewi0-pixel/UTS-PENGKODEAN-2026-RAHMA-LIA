        // Statistik Dashboard
        function renderDashboardStats() {
            const postedJournals = appState.journals.filter(j => j.status === 'POSTED');
            const draftJournals = appState.journals.filter(j => j.status === 'DRAFT');

            let totalAmount = 0;
            postedJournals.forEach(j => {
                j.lines.forEach(l => totalAmount += Number(l.debit) || 0);
            });

            document.getElementById("stat-total-posted").innerText = postedJournals.length;
            document.getElementById("stat-total-draft").innerText = draftJournals.length;
            document.getElementById("stat-total-amount").innerText = formatRupiah(totalAmount);
