<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Purwarupa Modul Voucher Kas Keluar - Akuntansi</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Supabase JS Client CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Header Aplikasi -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-600 text-white p-2 rounded-lg font-bold tracking-wider">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold leading-tight">Sistem Akuntansi Keuangan</h1>
                    <p class="text-xs text-slate-400">Modul Voucher Entri Kas Keluar & Audit Trail</p>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <div id="connection-status" class="hidden sm:flex items-center space-x-2 bg-slate-800 px-3 py-1.5 rounded-full text-xs">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" id="status-dot"></span>
                    <span id="status-text" class="text-slate-300">Mode Demo Lokal</span>
                </div>
                <div class="flex items-center space-x-2 border-l border-slate-700 pl-4">
                    <div class="w-8 h-8 rounded-full bg-emerald-700 flex items-center justify-center font-semibold text-sm">AI</div>
                    <div class="hidden md:block text-left">
                        <p class="text-xs font-medium" id="current-user-name">Auditor Internal / Akuntan</p>
                        <p class="text-[10px] text-emerald-400">Role: Accountant & Auditor</p>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row gap-6">
        
        <!-- Sidebar Navigasi -->
        <aside class="w-full md:w-64 shrink-0 space-y-2">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-3 space-y-1">
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider px-3 mb-2">Navigasi Utama</p>
                
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                    <span>Dashboard</span>
                </button>

                <button onclick="switchTab('voucher')" id="nav-voucher" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium bg-emerald-50 text-emerald-700 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    <span>Voucher Kas Keluar</span>
                </button>

                <button onclick="switchTab('journals')" id="nav-journals" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    <span>Daftar Jurnal</span>
                </button>

                <button onclick="switchTab('coa')" id="nav-coa" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" /></svg>
                    <span>Chart of Accounts</span>
                </button>

                <button onclick="switchTab('audit')" id="nav-audit" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>
                    <span>Audit Log</span>
                </button>
            </div>

            <!-- Panel Pengaturan Koneksi Supabase -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold text-slate-700 uppercase">Koneksi Supabase</h3>
                    <span id="db-status-badge" class="px-2 py-0.5 text-[10px] bg-amber-100 text-amber-800 rounded-full font-medium">Lokal / Demo</span>
                </div>
                <p class="text-xs text-slate-500">Hubungkan database Supabase untuk validasi PostgreSQL & penyimpanan riil.</p>
                <div class="space-y-2">
                    <input type="text" id="supabase-url" placeholder="Supabase URL (https://...)" class="w-full text-xs px-2.5 py-1.5 border border-slate-300 rounded focus:ring-1 focus:ring-emerald-500">
                    <input type="password" id="supabase-key" placeholder="Anon / Public Key" class="w-full text-xs px-2.5 py-1.5 border border-slate-300 rounded focus:ring-1 focus:ring-emerald-500">
                    <button onclick="initSupabaseConnection()" class="w-full bg-slate-800 hover:bg-slate-900 text-white text-xs font-medium py-1.5 rounded transition-colors">Hubungkan DB</button>
                </div>
            </div>

            <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-xs text-emerald-900 space-y-1">
                <p class="font-bold">Info Tugas Akuntansi:</p>
                <p>Prinsip <i>Zero-Discrepancy</i> mewajibkan total debit sama dengan total kredit, serta akun Kas wajib dikredit pada transaksi Kas Keluar.</p>
            </div>
        </aside>

        <!-- Area Konten Utama -->
        <main class="flex-1 space-y-6">

            <!-- Notifikasi / Alert Banner -->
            <div id="alert-banner" class="hidden p-4 rounded-xl text-sm border flex items-start justify-between transition-all duration-300">
                <div class="flex items-center space-x-2">
                    <div id="alert-icon"></div>
                    <div>
                        <p class="font-semibold" id="alert-title"></p>
                        <p class="text-xs" id="alert-message"></p>
                    </div>
                </div>
                <button onclick="closeAlert()" class="text-slate-400 hover:text-slate-600 text-xs">&times;</button>
            </div>

            <!-- TAB 1: DASHBOARD -->
            <div id="tab-content-dashboard" class="tab-content hidden space-y-6">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
                    <h2 class="text-lg font-bold text-slate-800">Dashboard Pengendalian Kas Keluar</h2>
                    <p class="text-sm text-slate-600">Ringkasan transaksi akuntansi, status voucher, dan audit trail operasional kas.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
                        <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-1">
                            <p class="text-xs text-slate-500 font-medium">Total Voucher Posted</p>
                            <p class="text-2xl font-bold text-slate-800" id="stat-total-posted">0</p>
                            <p class="text-[10px] text-emerald-600 font-medium">+0% dari bulan lalu</p>
                        </div>
                        <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-1">
                            <p class="text-xs text-slate-500 font-medium">Draft Voucher</p>
                            <p class="text-2xl font-bold text-amber-600" id="stat-total-draft">1</p>
                            <p class="text-[10px] text-slate-500 font-medium">Belum diposting</p>
                        </div>
                        <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-1">
                            <p class="text-xs text-slate-500 font-medium">Total Kas Keluar (Posted)</p>
                            <p class="text-2xl font-bold text-emerald-600" id="stat-total-amount">Rp0,00</p>
                            <p class="text-[10px] text-emerald-600 font-medium">Terverifikasi zero-discrepancy</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
                    <h3 class="font-bold text-slate-800 text-sm">Panduan Singkat Auditor Internal</h3>
                    <ul class="list-disc list-inside text-sm text-slate-600 space-y-1.5">
                        <li>Pastikan setiap voucher pengeluaran kas memiliki bukti pendukung fisik / digital.</li>
                        <li>Sistem menolak posting jika total debit $\neq$ total kredit atau akun kas tidak dikredit.</li>
                        <li>Seluruh perubahan dicatat otomatis di tabel <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs text-slate-700">audit_logs</code>.</li>
                    </ul>
                </div>
            </div>

            <!-- TAB 2: VOUCHER KAS KELUAR (FORM UTAMA) -->
            <div id="tab-content-voucher" class="tab-content space-y-6">
                
                <!-- Header Formulir & Status -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-4 border-b border-slate-100 gap-4">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">Voucher Entri Transaksi Kas Keluar</h2>
                            <p class="text-xs text-slate-500">Formulir penjurnalan pengeluaran kas dengan validasi akuntansi real-time.</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span id="voucher-status-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">DRAFT</span>
                            <span id="balance-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">BELUM LENGKAP</span>
                        </div>
                    </div>

                    <!-- Input Header Transaksi -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Transaksi <span class="text-red-500">*</span></label>
                            <input type="date" id="tx-date" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" onchange="validateForm()">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nomor Voucher (Unik) <span class="text-red-500">*</span></label>
                            <input type="text" id="tx-ref" value="VKK-2026-001" placeholder="Cth: VKK-2026-001" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" oninput="validateForm()">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Pembuat Voucher (User)</label>
                            <input type="text" id="tx-user" value="Akuntan Utama (Staff)" disabled class="w-full text-sm bg-slate-100 border border-slate-200 rounded-lg px-3 py-2 text-slate-500">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi / Keterangan Transaksi <span class="text-red-500">*</span></label>
                        <textarea id="tx-desc" rows="2" placeholder="Contoh: Pembayaran beban operasional kantor bulan Oktober 2026" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none" oninput="validateForm()">Pembayaran beban operasional kantor tunai</textarea>
                    </div>
                </div>

                <!-- Kartu Ringkasan Keseimbangan & Total -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-white border border-slate-200 p-4 rounded-xl shadow-sm space-y-1">
                        <p class="text-xs font-medium text-slate-500">Total Debit (Rp)</p>
                        <p class="text-xl font-bold text-slate-800" id="display-total-debit">Rp0,00</p>
                    </div>
                    <div class="bg-white border border-slate-200 p-4 rounded-xl shadow-sm space-y-1">
                        <p class="text-xs font-medium text-slate-500">Total Kredit (Rp)</p>
                        <p class="text-xl font-bold text-slate-800" id="display-total-credit">Rp0,00</p>
                    </div>
                    <div class="bg-white border border-slate-200 p-4 rounded-xl shadow-sm space-y-1" id="diff-card">
                        <p class="text-xs font-medium text-slate-500">Selisih (Discrepancy)</p>
                        <p class="text-xl font-bold text-red-600" id="display-diff">Rp0,00</p>
                    </div>
                </div>

                <!-- Tabel Jurnal Dinamis -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3 class="font-bold text-slate-800 text-sm">Detail Baris Jurnal</h3>
                            <p class="text-xs text-slate-500">Minimal 2 baris valid. Kas harus dikredit pada pengeluaran kas.</p>
                        </div>
                        <button onclick="addJournalRow()" class="bg-slate-800 hover:bg-slate-900 text-white text-xs px-3 py-2 rounded-lg font-medium transition-colors flex items-center space-x-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                            <span>Tambah Baris</span>
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3 px-2 w-12">#</th>
                                    <th class="py-3 px-2 w-72">Akun (Chart of Accounts)</th>
                                    <th class="py-3 px-2">Debit (Rp)</th>
                                    <th class="py-3 px-2">Kredit (Rp)</th>
                                    <th class="py-3 px-2">Keterangan Baris</th>
                                    <th class="py-3 px-2 w-16 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="journal-rows-container" class="divide-y divide-slate-100 text-sm">
                                <!-- Baris akan di-generate via JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Tombol Aksi Bawah -->
                    <div class="flex flex-wrap items-center justify-between pt-4 border-t border-slate-100 gap-3">
                        <div class="flex items-center space-x-2">
                            <button onclick="loadDemoValid()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2 rounded-lg font-medium transition-colors">Muat Contoh Valid</button>
                            <button onclick="loadDemoUnbalanced()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2 rounded-lg font-medium transition-colors">Muat Contoh Tidak Seimbang</button>
                        </div>
                        <div class="flex items-center space-x-3">
                            <button onclick="saveDraft()" class="border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs px-4 py-2 rounded-lg font-medium transition-colors">Simpan Draft</button>
                            <button onclick="postJournal()" id="btn-post" disabled class="bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white text-xs px-5 py-2 rounded-lg font-bold shadow-sm transition-colors">Posting Jurnal (Submit)</button>
                        </div>
                    </div>
                </div>

                <!-- Kotak Pesan Validasi Khusus -->
                <div id="validation-feedback-box" class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs text-amber-900 space-y-1">
                    <p class="font-bold flex items-center space-x-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        <span>Pesan Validasi Akuntansi:</span>
                    </p>
                    <ul id="validation-errors-list" class="list-disc list-inside space-y-0.5 text-amber-800 pl-1">
                        <li>Memeriksa ketentuan zero-discrepancy dan akun kas...</li>
                    </ul>
                </div>

            </div>

            <!-- TAB 3: DAFTAR JURNAL -->
            <div id="tab-content-journals" class="tab-content hidden space-y-6">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">Daftar Voucher & Jurnal Tercatat</h2>
                            <p class="text-xs text-slate-500">Arsip jurnal yang telah tersimpan sebagai draft maupun diposting.</p>
                        </div>
                        <button onclick="renderJournalsList()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2 rounded-lg font-medium">Perbarui Data</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3 px-3">No. Voucher</th>
                                    <th class="py-3 px-3">Tanggal</th>
                                    <th class="py-3 px-3">Deskripsi</th>
                                    <th class="py-3 px-3">Status</th>
                                    <th class="py-3 px-3 text-right">Total (Rp)</th>
                                    <th class="py-3 px-3 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="journals-table-body" class="divide-y divide-slate-100 text-sm">
                                <!-- Data jurnal dimuat di sini -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 4: CHART OF ACCOUNTS (COA) -->
            <div id="tab-content-coa" class="tab-content hidden space-y-6">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">Bagan Akun (Chart of Accounts)</h2>
                            <p class="text-xs text-slate-500">Daftar akun master yang digunakan untuk penjurnalan transaksi.</p>
                        </div>
                        <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-lg">Data Demo Aktif</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3 px-3">Kode Akun</th>
                                    <th class="py-3 px-3">Nama Akun</th>
                                    <th class="py-3 px-3">Saldo Normal</th>
                                    <th class="py-3 px-3">Klasifikasi Laporan</th>
                                    <th class="py-3 px-3 text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody id="coa-table-body" class="divide-y divide-slate-100 text-sm">
                                <!-- COA dimuat via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 5: AUDIT LOG -->
            <div id="tab-content-audit" class="tab-content hidden space-y-6">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">Catatan Riwayat Audit (Audit Log)</h2>
