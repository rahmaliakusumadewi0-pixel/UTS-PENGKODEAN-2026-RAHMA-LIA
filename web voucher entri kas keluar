        // Modal Detail
        function viewJournalDetail(id) {
            const j = appState.journals.find(item => item.id === id);
            if (!j) return;

            document.getElementById("modal-title").innerText = `Detail Voucher: ${j.reference_number}`;
            let linesHtml = `<div class="space-y-2 text-xs"><p><strong>Tanggal:</strong> ${j.transaction_date}</p><p><strong>Status:</strong> ${j.status}</p><p><strong>Deskripsi:</strong> ${j.description}</p><p><strong>Dibuat oleh:</strong> ${j.created_by} (${j.created_at})</p>`;
            if (j.posted_by) linesHtml += `<p><strong>Diposting oleh:</strong> ${j.posted_by} (${j.posted_at})</p>`;
            
            linesHtml += `<table class="w-full mt-3 border border-slate-200"><thead><tr class="bg-slate-100 text-slate-700"><th class="p-2 border">Akun</th><th class="p-2 border">Debit</th><th class="p-2 border">Kredit</th></tr></thead><tbody>`;
            
            j.lines.forEach(l => {
                const acc = chartOfAccounts.find(a => a.id === l.account_id);
                linesHtml += `<tr><td class="p-2 border">${acc ? acc.code + ' - ' + acc.name : l.account_id}</td><td class="p-2 border text-right font-mono">${formatRupiah(l.debit)}</td><td class="p-2 border text-right font-mono">${formatRupiah(l.credit)}</td></tr>`;
            });
            linesHtml += `</tbody></table></div>`;

            document.getElementById("modal-body").innerHTML = linesHtml;
            document.getElementById("detail-modal").classList.remove("hidden");
        }

        function closeModal() {
            document.getElementById("detail-modal").classList.add("hidden");
        }

        // Helper Format Rupiah
        function formatRupiah(amount) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 2 }).format(amount);
        }

        // Notifikasi Toast
        function showAlert(title, message, type) {
            const banner = document.getElementById("alert-banner");
            const titleEl = document.getElementById("alert-title");
            const msgEl = document.getElementById("alert-message");
            
            titleEl.innerText = title;
            msgEl.innerText = message;

            if (type === 'green') {
                banner.className = "p-4 rounded-xl text-sm border bg-emerald-50 border-emerald-200 text-emerald-900 flex items-start justify-between shadow-sm transition-all";
            } else if (type === 'red') {
                banner.className = "p-4 rounded-xl text-sm border bg-red-50 border-red-200 text-red-900 flex items-start justify-between shadow-sm transition-all";
            } else {
                banner.className = "p-4 rounded-xl text-sm border bg-amber-50 border-amber-200 text-amber-900 flex items-start justify-between shadow-sm transition-all";
            }

            banner.classList.remove("hidden");
            setTimeout(() => { banner.classList.add("hidden"); }, 5000);
        }

        function closeAlert() {
            document.getElementById("alert-banner").classList.add("hidden");
        }

        // Koneksi Supabase Opsional
        function initSupabaseConnection() {
            const url = document.getElementById("supabase-url").value.trim();
            const key = document.getElementById("supabase-key").value.trim();

            if (!url || !key) {
                showAlert("Peringatan", "Masukkan URL dan Public Anon Key Supabase dengan benar.", "amber");
                return;
            }

            try {
                supabaseClient = supabase.createClient(url, key);
                document.getElementById("status-dot").className = "w-2.5 h-2.5 rounded-full bg-emerald-500";
                document.getElementById("status-text").innerText = "Terhubung ke Supabase";
                document.getElementById("db-status-badge").innerText = "Terhubung";
                document.getElementById("db-status-badge").className = "px-2 py-0.5 text-[10px] bg-emerald-100 text-emerald-800 rounded-full font-medium";
                showAlert("Koneksi Berhasil", "Klien JavaScript Supabase berhasil diinisialisasi.", "green");
            } catch (err) {
                showAlert("Gagal Koneksi", err.message, "red");
            }
        }
    </script>
</body>
</html>
