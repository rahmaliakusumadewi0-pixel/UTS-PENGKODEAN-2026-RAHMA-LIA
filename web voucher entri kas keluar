            { id: "101", code: "101", name: "Kas di Bank / Tunai", normal_balance: "Debit", classification: "Aset", is_active: true, is_cash: true },
            { id: "102", code: "102", name: "Piutang Usaha", normal_balance: "Debit", classification: "Aset", is_active: true, is_cash: false },
            { id: "103", code: "103", name: "Persediaan Barang Dagang", normal_balance: "Debit", classification: "Aset", is_active: true, is_cash: false },
            { id: "104", code: "104", name: "Perlengkapan Kantor", normal_balance: "Debit", classification: "Aset", is_active: true, is_cash: false },
            { id: "201", code: "201", name: "Utang Usaha", normal_balance: "Kredit", classification: "Liabilitas", is_active: true, is_cash: false },
            { id: "601", code: "601", name: "Beban Operasional Kantor", normal_balance: "Debit", classification: "Beban", is_active: true, is_cash: false },
            { id: "602", code: "602", name: "Beban Gaji Karyawan", normal_balance: "Debit", classification: "Beban", is_active: true, is_cash: false },
            { id: "603", code: "603", name: "Beban Listrik, Air & Internet", normal_balance: "Debit", classification: "Beban", is_active: true, is_cash: false }
        ];

        // State Aplikasi Lokal (Simulasi database jika Supabase belum dikonfigurasi)
        let appState = {
            rows: [
                { id: 1, account_id: "601", debit: 1000000, credit: 0, description: "Beban operasional Oktober" },
                { id: 2, account_id: "101", debit: 0, credit: 1000000, description: "Pengeluaran Kas Tunai" }
            ],
            journals: [
                {
                    id: "vkk-demo-0",
                    reference_number: "VKK-2026-000",
                    transaction_date: "2026-10-01",
                    description: "Pembayaran awal beban sewa gedung",
                    status: "POSTED",
                    created_by: "Akuntan Utama",
                    created_at: "2026-10-01 08:30:00",
                    posted_by: "Supervisor Auditor",
                    posted_at: "2026-10-01 08:35:00",
                    lines: [
                        { account_id: "601", debit: 2500000, credit: 0, description: "Sewa Gedung" },
                        { account_id: "101", debit: 0, credit: 2500000, description: "Kas Keluar" }
                    ]
                }
            ],
            auditLogs: [
                { id: 1, time: "2026-10-01 08:30:00", user: "Akuntan Utama", action: "CREATE_DRAFT", ref: "VKK-2026-000", details: "Draft voucher awal dibuat" },
                { id: 2, time: "2026-10-01 08:35:00", user: "Supervisor Auditor", action: "POST_JOURNAL", ref: "VKK-2026-000", details: "Jurnal diposting dengan zero-discrepancy terverifikasi" }
            ]
        };

        let supabaseClient = null;

        // Inisialisasi Tanggal Hari Ini pada Form
        document.addEventListener("DOMContentLoaded", () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById("tx-date").value = today;
            renderCOA();
            renderJournalRows();
            validateForm();
            renderDashboardStats();
        });

        // Navigasi Antar Tab
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-content-${tabId}`).classList.remove('hidden');

            // Update style tombol navigasi
            ['dashboard', 'voucher', 'journals', 'coa', 'audit'].forEach(id => {
                const btn = document.getElementById(`nav-${id}`);
                if (id === tabId) {
                    btn.className = "w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium bg-emerald-50 text-emerald-700 transition-colors";
                } else {
                    btn.className = "w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors";
                }
            });

            if (tabId === 'journals') renderJournalsList();
            if (tabId === 'audit') renderAuditLogs();
            if (tabId === 'dashboard') renderDashboardStats();
        }

        // Render Baris Jurnal Dinamis
        function renderJournalRows() {
            const container = document.getElementById("journal-rows-container");
            container.innerHTML = "";

            appState.rows.forEach((row, index) => {
                const tr = document.createElement("tr");
                tr.className = "border-b border-slate-100 hover:bg-slate-50/50 transition-colors";

                let accountOptions = chartOfAccounts.map(acc => 
                    `<option value="${acc.id}" ${row.account_id === acc.id ? 'selected' : ''}>${acc.code} - ${acc.name} (${acc.classification})</option>`
                ).join('');

                tr.innerHTML = `
                    <td class="py-3 px-2 text-xs font-semibold text-slate-500">${index + 1}</td>
                    <td class="py-3 px-2">
                        <select onchange="updateRow(${row.id}, 'account_id', this.value)" class="w-full text-xs border border-slate-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-emerald-500">
                            <option value="">-- Pilih Akun --</option>
                            ${accountOptions}
                        </select>
                    </td>
                    <td class="py-3 px-2">
                        <input type="number" min="0" value="${row.debit || 0}" oninput="updateRow(${row.id}, 'debit', this.value)" class="w-full text-xs border border-slate-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-emerald-500 font-mono">
                    </td>
                    <td class="py-3 px-2">
                        <input type="number" min="0" value="${row.credit || 0}" oninput="updateRow(${row.id}, 'credit', this.value)" class="w-full text-xs border border-slate-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-emerald-500 font-mono">
                    </td>
                    <td class="py-3 px-2">
                        <input type="text" value="${row.description || ''}" placeholder="Keterangan baris..." oninput="updateRow(${row.id}, 'description', this.value)" class="w-full text-xs border border-slate-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-emerald-500">
                    </td>
                    <td class="py-3 px-2 text-center">
                        <button onclick="removeJournalRow(${row.id})" class="text-red-500 hover:text-red-700 p-1 rounded transition-colors" title="Hapus Baris">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                    </td>
                `;
                container.appendChild(tr);
            });

            calculateTotals();
        }

        function addJournalRow() {
            const newId = appState.rows.length > 0 ? Math.max(...appState.rows.map(r => r.id)) + 1 : 1;
            appState.rows.push({ id: newId, account_id: "", debit: 0, credit: 0, description: "" });
            renderJournalRows();
            validateForm();
        }

        function removeJournalRow(id) {
            if (appState.rows.length <= 1) {
                showAlert("Peringatan", "Minimal harus ada 1 baris dalam tabel jurnal.", "amber");
                return;
            }
            appState.rows = appState.rows.filter(r => r.id !== id);
            renderJournalRows();
            validateForm();
        }

        function updateRow(id, field, value) {
            const row = appState.rows.find(r => r.id === id);
            if (row) {
                if (field === 'debit' || field === 'credit') {
                    row[field] = parseFloat(value) || 0;
                    // Jika diisi debit, set kredit ke 0 (aturan satu baris tidak boleh debit & kredit bersamaan)
                    if (field === 'debit' && row[field] > 0) row.credit = 0;
                    if (field === 'credit' && row[field] > 0) row.debit = 0;
                } else {
                    row[field] = value;
                }
            }
            calculateTotals();
            validateForm();
        }

        // Kalkulasi Total & Zero-Discrepancy
        function calculateTotals() {
            let totalDebit = 0;
            let totalCredit = 0;

            appState.rows.forEach(r => {
                totalDebit += Number(r.debit) || 0;
                totalCredit += Number(r.credit) || 0;
            });

            const diff = Math.abs(totalDebit - totalCredit);

            document.getElementById("display-total-debit").innerText = formatRupiah(totalDebit);
            document.getElementById("display-total-credit").innerText = formatRupiah(totalCredit);
            document.getElementById("display-diff").innerText = formatRupiah(diff);

            const diffCard = document.getElementById("diff-card");
            if (diff === 0 && totalDebit > 0) {
                diffCard.className = "bg-emerald-50 border border-emerald-200 p-4 rounded-xl shadow-sm space-y-1";
                document.getElementById("display-diff").className = "text-xl font-bold text-emerald-600";
            } else {
                diffCard.className = "bg-red-50 border border-red-200 p-4 rounded-xl shadow-sm space-y-1";
                document.getElementById("display-diff").className = "text-xl font-bold text-red-600";
            }
        }

        // Validasi Aturan Akuntansi & Tombol Posting
        function validateForm() {
            let errors = [];
            let totalDebit = 0;
            let totalCredit = 0;
            let hasCashCredit = false;
            let validRowsCount = 0;

            const txDate = document.getElementById("tx-date").value;
            const txRef = document.getElementById("tx-ref").value.trim();
            const txDesc = document.getElementById("tx-desc").value.trim();

            if (!txDate) errors.push("Tanggal transaksi belum diisi.");
            if (!txRef) errors.push("Nomor voucher wajib diisi dan unik.");
            if (!txDesc) errors.push("Deskripsi transaksi wajib diisi.");

            if (appState.rows.length < 2) {
                errors.push("Minimal terdapat dua baris jurnal untuk transaksi berpasangan.");
            }

            appState.rows.forEach((r, idx) => {
                if (!r.account_id) {
                    errors.push(`Baris #${idx + 1}: Akun belum dipilih.`);
                } else {
                    const accObj = chartOfAccounts.find(a => a.id === r.account_id);
                    if (accObj && accObj.is_cash && Number(r.credit) > 0) {
                        hasCashCredit = true;
                    }
                }

                const d = Number(r.debit) || 0;
                const c = Number(r.credit) || 0;

                if (d < 0 || c < 0) errors.push(`Baris #${idx + 1}: Nilai nominal tidak boleh negatif.`);
                if (d > 0 && c > 0) errors.push(`Baris #${idx + 1}: Debit dan kredit tidak boleh terisi bersamaan pada satu baris.`);
                if (d === 0 && c === 0) errors.push(`Baris #${idx + 1}: Nilai debit atau kredit harus diisi.`);

                if ((d > 0 || c > 0) && r.account_id) {
                    validRowsCount++;
                }

                totalDebit += d;
                totalCredit += c;
            });

            if (!hasCashCredit) {
                errors.push("Aturan Kas Keluar: Minimal satu baris harus mengkredit akun Kas (101).");
            }

            if (totalDebit !== totalCredit || totalDebit === 0) {
                errors.push(`Prinsip Zero-Discrepancy belum terpenuhi (Total Debit: ${formatRupiah(totalDebit)}, Total Kredit: ${formatRupiah(totalCredit)}, Selisih: ${formatRupiah(Math.abs(totalDebit - totalCredit))}).`);
            }

            const errorListEl = document.getElementById("validation-errors-list");
            const feedbackBox = document.getElementById("validation-feedback-box");
            const balanceBadge = document.getElementById("balance-badge");
            const btnPost = document.getElementById("btn-post");

            errorListEl.innerHTML = "";

            if (errors.length === 0) {
                feedbackBox.className = "bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-xs text-emerald-900 space-y-1";
                errorListEl.innerHTML = "<li class='font-semibold text-emerald-700'>Seluruh aturan akuntansi, validasi zero-discrepancy, dan akun Kas terpenuhi. Jurnal siap diposting!</li>";
                balanceBadge.innerText = "SEIMBANG & VALID";
                balanceBadge.className = "px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800";
                btnPost.disabled = false;
            } else {
                feedbackBox.className = "bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs text-amber-900 space-y-1";
                errors.forEach(err => {
                    const li = document.createElement("li");
                    li.innerText = err;
                    errorListEl.appendChild(li);
                });
                balanceBadge.innerText = totalDebit === totalCredit && totalDebit > 0 ? "SEIMBANG" : "TIDAK SEIMBANG / BELUM LENGKAP";
                balanceBadge.className = totalDebit === totalCredit && totalDebit > 0 ? "px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800" : "px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700";
                btnPost.disabled = true;
            }

            return errors.length === 0;
        }

        // Aksi Simpan Draft
        function saveDraft() {
            const txRef = document.getElementById("tx-ref").value.trim();
            if (!txRef) {
                showAlert("Gagal", "Nomor voucher wajib diisi untuk menyimpan draft.", "red");
                return;
            }

            const newJournal = {
                id: 'vkk-' + Date.now(),
                reference_number: txRef,
                transaction_date: document.getElementById("tx-date").value,
                description: document.getElementById("tx-desc").value,
                status: "DRAFT",
                created_by: "Akuntan Utama",
                created_at: new Date().toISOString().replace('T', ' ').substring(0, 19),
                lines: JSON.parse(JSON.stringify(appState.rows))
            };

            appState.journals.push(newJournal);
            appState.auditLogs.unshift({
                id: appState.auditLogs.length + 1,
                time: new Date().toISOString().replace('T', ' ').substring(0, 19),
                user: "Akuntan Utama",
                action: "CREATE_DRAFT",
                ref: txRef,
                details: "Voucher kas keluar disimpan sebagai draft."
            });

            showAlert("Berhasil", `Voucher ${txRef} berhasil disimpan sebagai Draft.`, "green");
            renderDashboardStats();
        }

        // Aksi Posting Jurnal
        function postJournal() {
            if (!validateForm()) {
                showAlert("Gagal Posting", "Validasi akuntansi gagal. Periksa kembali entri jurnal Anda.", "red");
                return;
            }

            const txRef = document.getElementById("tx-ref").value.trim();

            // Cek duplikasi nomor voucher
            const existing = appState.journals.find(j => j.reference_number === txRef && j.status === "POSTED");
            if (existing) {
                showAlert("Gagal Posting", `Nomor voucher ${txRef} sudah pernah diposting sebelumnya (Duplikasi ditolak).`, "red");
                return;
            }

            const postedJournal = {
                id: 'vkk-' + Date.now(),
                reference_number: txRef,
                transaction_date: document.getElementById("tx-date").value,
                description: document.getElementById("tx-desc").value,
                status: "POSTED",
                created_by: "Akuntan Utama",
                created_at: new Date().toISOString().replace('T', ' ').substring(0, 19),
                posted_by: "Supervisor Auditor",
                posted_at: new Date().toISOString().replace('T', ' ').substring(0, 19),
                lines: JSON.parse(JSON.stringify(appState.rows))
            };

            appState.journals.push(postedJournal);
            appState.auditLogs.unshift({
                id: appState.auditLogs.length + 1,
                time: new Date().toISOString().replace('T', ' ').substring(0, 19),
                user: "Supervisor Auditor",
                action: "POST_JOURNAL",
                ref: txRef,
                details: "Jurnal kas keluar diposting dengan sukses. Zero-discrepancy terverifikasi."
            });

            document.getElementById("voucher-status-badge").innerText = "POSTED";
            document.getElementById("voucher-status-badge").className = "px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800";

            showAlert("Sukses Posting!", `Voucher ${txRef} berhasil diposting ke Buku Besar dengan status POSTED secara atomik.`, "green");
            renderDashboardStats();
            
            // Auto generate nomor voucher baru berikutnya
            document.getElementById("tx-ref").value = "VKK-2026-0" + (Math.floor(Math.random() * 90) + 10);
        }

